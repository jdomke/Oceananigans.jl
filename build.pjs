#!/bin/bash
#PJM -L "node=1"
#PJM -L "rscunit=rscunit_ft01"
#PJM -L "rscgrp=small"
#PJM -L "elapse=02:00:00"
#PJM --llio cn-cache-size=4096Mi
#PJM --llio localtmp-size=80Gi
#PJM -x PJM_LLIO_GFSCACHE='/vol0002:/vol0003:/vol0004:/vol0005:/vol0006'
#PJM --mpi max-proc-per-node=1
#PJM -L freq=2200
#PJM -L throttling_state=0
#PJM -L issue_state=0
#PJM -L ex_pipe_state=0
#PJM -L eco_state=0
#PJM -L retention_state=0
#PJM -j

set +e  #commands returning non-zero exit codes will not cause the entire script to fail
set -x
if ! lscpu | grep 'sve' >/dev/null 2>&1; then echo "ERR: not on login node"; exit 1; fi

mkdir -p $HOME/.spack/cache
. /vol0004/apps/oss/spack/share/spack/setup-env.sh
COMP="gcc@13.2.0"
ARCH="arch=linux-rhel8-a64fx"
spack load gcc@13.2.0 ${ARCH}
spack load automake@1.16.1 %${COMP} ${ARCH}
spack load autoconf@2.69 %${COMP} ${ARCH}
spack load python@3.11.6 %${COMP} ${ARCH}
spack load py-setuptools@59.4.0 %${COMP} ${ARCH}
spack load py-numpy@1.24.4 %${COMP} ${ARCH}
spack load perl@5.26.3 %${COMP} ${ARCH}
spack load m4@1.4.18 %${COMP} ${ARCH}
spack load cmake@3.27.7 /zbtdwl7 %${COMP} ${ARCH}
spack load pkgconf@1.4.2 %${COMP} ${ARCH}
spack load curl@8.4.0 /bimducx %${COMP} ${ARCH}

ROOTDIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

cd julia/
MBD="$(pwd)/mybuilddir"
rm -rf "${MBD}"; mkdir "${MBD}"
make O="${MBD}" configure

cp Make.inc "${MBD}/"
INSTDIR="${ROOTDIR}/inst/julia"
export JULIA_DEPOT_PATH="${INSTDIR}/.julia"
rm -rf "${INSTDIR}" "${JULIA_DEPOT_PATH}"

make -j$(nproc) 2>&1 | tee mymake.log
make prefix="${INSTDIR}" install
cd "${INSTDIR}/lib/"
find julia/ -mindepth 1 -exec ln -s {} \;
cd "${ROOTDIR}/"

alias julia="${INSTDIR}/bin/julia"

unset OMP_NUM_THREADS; unset JULIA_NUM_THREADS
export OMP_NUM_THREADS=$(nproc)
export JULIA_NUM_THREADS=$(nproc)
# fix known bugs: https://juliaparallel.org/MPI.jl/latest/knownissues/#Multi-threading-and-signal-handling
export UCX_ERROR_SIGNALS="SIGILL,SIGBUS,SIGFPE"
export ZES_ENABLE_SYSMAN=1

julia -e 'using Pkg; Pkg.add("BenchmarkTools"); Pkg.add(url="https://github.com/jdomke/FujitsuBLAS.jl.git"); Pkg.add("LinearAlgebra"); Pkg.add("LLVM"); Pkg.add("Reactant");'

julia -e "using Pkg; Pkg.add(\"MPIPreferences\"); using MPIPreferences; MPIPreferences.use_system_binary(mpiexec=\"$(readlink -f $(which mpirun))\", library_names=[\"$(readlink -f $(dirname $(which mpirun))/../lib64/libmpi.so)\"]); Pkg.add(\"MPI\");"
/bin/echo -e '\n[OpenMPI_jll]' >> ${JULIA_DEPOT_PATH}/environments/v*/LocalPreferences.toml; /bin/grep '^libmpi\|^mpiexec' ${JULIA_DEPOT_PATH}/environments/v*/LocalPreferences.toml | /bin/sed -e 's@ =@_path =@' >> ${JULIA_DEPOT_PATH}/environments/v*/LocalPreferences.toml
#hdf5 must find libmpi.so.40
ln -s "$(readlink -f $(dirname $(which mpirun))/../lib64/libmpi.so)" ${INSTDIR}/lib/libmpi.so.40
export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+${LD_LIBRARY_PATH}:}${INSTDIR}/lib"

julia -e 'using Pkg; Pkg.add("OpenMPI_jll");'
julia -e 'using Pkg; Pkg.add("Oceananigans"); Pkg.status("Oceananigans");'
julia -e 'using Pkg; Pkg.add("Reactant_jll"); Pkg.add("ClimaOcean"); Pkg.add("OrthogonalSphericalShellGrids"); Pkg.add("CFTime");'
